# Reference only: this project does not load .env automatically.
# Supply these variables through the process environment or hosting settings.
PORT=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
GOOGLE_APPLICATION_CREDENTIALS=

# Catalog Core operational command (never put credential contents here).
CATALOG_GCP_PROJECT_ID=
CATALOG_FIRESTORE_DATABASE_ID=(default)
CATALOG_SPREADSHEET_ID=

# Optional path to the Google service-account JSON file. Defaults to the
# hosting path /etc/secrets/google-service-account.json when unset.
# Keep the credential file outside the repository; never put its contents here.
